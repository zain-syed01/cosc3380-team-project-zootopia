DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=final_zoo_db
PORT=3000
# set to true on Azure MySQL; leave false/unset for local
DB_SSL=false
# optional; built automatically from DB_* above when omitted
# DATABASE_URL=mysql://root:your_password_here@127.0.0.1:3306/final_zoo_db
JWT_SECRET=change-me-to-a-long-random-string

# Azure App Service: keep rebuild off so CI artifacts are not overwritten
# SCM_DO_BUILD_DURING_DEPLOYMENT=false
